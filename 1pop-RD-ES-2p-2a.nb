Cell["Source code", "Section",ExpressionUUID->"d7fc9b4c-924e-445b-8538-aebcffdbf017"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rules", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<C\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<D\>\"", "->", "1"}], ",", 
          RowBox[{"\"\<L\>\"", "->", "2"}]}], "}"}]}], ",", "s1", ",", "s2", ",",
        "payoffs", ",", "L", ",", "FMatrix", ",", "listOfArrows", ",", 
       "arrowStarts", ",", "arrowChanges", ",", "fastestArrow", ",", 
       "maxArrowLength", ",", "restBranches", ",", "restPointsX", ",", 
       "restBounds", ",", "everyStateRests", ",", "x1", ",", "height", ",", 
       "payoffMin", ",", "payoffMax", ",", "payoffSpan", ",", "fontSize"}], 
      "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"s1", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"b1", ",", "b2", ",", "b3", ",", "b4", ",", "b5"}], "}"}], "/.",
         "rules"}]}], ";", 
      RowBox[{"s1Name", "=", 
       RowBox[{"StrategyName", "[", "s1", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"s2", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"o1", ",", "o2", ",", "o3", ",", "o4", ",", "o5"}], "}"}], "/.",
         "rules"}]}], ";", 
      RowBox[{"s2Name", "=", 
       RowBox[{"StrategyName", "[", "s2", "]"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", "update", ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "This", " ", "is", " ", "a", " ", "trick", " ", "to", " ", "make", " ",
         "the", " ", "\"\<update\>\"", " ", "button", " ", "work"}], " ", 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"payoffs", "=", 
       RowBox[{"{", 
        RowBox[{"a11", ",", "a12", ",", "a21", ",", "a22"}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "The", " ", "phase", " ", "line", " ", "is", " ", "drawn", " ", 
        "below", " ", "the", " ", "payoff", " ", "range", " ", "so", " ", 
        "that", " ", "it", " ", "is", " ", "always"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"visible", ",", " ", 
        RowBox[{
        "whatever", " ", "the", " ", "four", " ", "payoff", " ", "sliders", " ",
          "are", " ", "set", " ", 
         RowBox[{"to", ".", " ", "The"}], " ", "span", " ", "is"}]}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "floored", " ", "at", " ", "1", " ", "to", " ", "cover", " ", "a", " ",
         "game", " ", "whose", " ", "four", " ", "payoffs", " ", "all", " ", 
        RowBox[{"coincide", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"payoffMin", "=", 
       RowBox[{"Min", "[", "payoffs", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"payoffMax", "=", 
       RowBox[{"Max", "[", "payoffs", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"payoffSpan", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"payoffMax", "-", "payoffMin"}], ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"height", "=", 
       RowBox[{"payoffMin", "-", 
        RowBox[{"0.075", "*", "payoffSpan"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{"Ls", "[", 
        RowBox[{"s1", ",", "s2", ",", "\[Epsilon]", ",", "\[Delta]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"FMatrix", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"F", "[", 
            RowBox[{"s1", ",", "s1", ",", 
             StyleBox["\[Epsilon]",
              FontSlant->"Italic"], ",", "\[Delta]", ",", "payoffs"}], "]"}], 
           ",", 
           RowBox[{"F", "[", 
            RowBox[{"s1", ",", "s2", ",", 
             StyleBox["\[Epsilon]",
              FontSlant->"Italic"], ",", "\[Delta]", ",", "payoffs"}], 
            "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"F", "[", 
            RowBox[{"s2", ",", "s1", ",", 
             StyleBox["\[Epsilon]",
              FontSlant->"Italic"], ",", "\[Delta]", ",", "payoffs"}], "]"}], 
           ",", 
           RowBox[{"F", "[", 
            RowBox[{"s2", ",", "s2", ",", 
             StyleBox["\[Epsilon]",
              FontSlant->"Italic"], ",", "\[Delta]", ",", "payoffs"}], 
            "]"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Range", " ", "always", " ", "includes", " ", "its", " ", "starting", 
         " ", "value"}], ",", " ", 
        RowBox[{
        "so", " ", "with", " ", "the", " ", "none", " ", "setting"}]}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"of", " ", "the", " ", "arrows", " ", "control"}], ",", " ", 
        RowBox[{
        "whose", " ", "step", " ", "is", " ", "wider", " ", "than", " ", 
         "the", " ", "interval"}], ",", " ", "the"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "empty", " ", "list", " ", "has", " ", "to", " ", "be", " ", "given", " ", 
        RowBox[{"explicitly", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"arrowStarts", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"step", ">", "1"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "1", ",", "step"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"arrowChanges", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ChangeInX1", "[", 
           RowBox[{"#", ",", "m", ",", "L", ",", "FMatrix"}], "]"}], "&"}], ",",
          "arrowStarts"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Arrows", " ", "are", " ", "scaled", " ", "so", " ", "that", " ", 
        "the", " ", "fastest", " ", "one", " ", "on", " ", "the", " ", "grid",
         " ", "is"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"maxArrowLength", " ", 
        RowBox[{"long", ".", " ", "That"}], " ", "keeps", " ", "the", " ", 
        "relative", " ", "speeds", " ", "visible", " ", "and"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"bounds", " ", "the", " ", 
        RowBox[{"length", ".", " ", "The"}], " ", "expected", " ", "change", " ",
         "itself", " ", "is", " ", 
        RowBox[{"unbounded", ":", " ", "with"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "a", " ", "payoff", " ", "spread", " ", "large", " ", "against", " ", 
        "the", " ", "mean", " ", "it", " ", "reaches", " ", "0.8", " ", "of", 
        " ", "the", " ", 
        RowBox[{"plot", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"maxArrowLength", "=", 
       RowBox[{"lengthArrows", "*", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"0.8", "*", "step"}], ",", "0.1"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fastestArrow", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "arrowChanges", "]"}], ",", 
          RowBox[{"10.", "^", 
           RowBox[{"-", "12"}]}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"listOfArrows", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#2", "==", "0."}], ",", "Nothing", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Arrowheads", "[", "0.03", "]"}], ",", 
              RowBox[{"Arrow", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"#1", ",", "height"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"#1", "+", 
                    RowBox[{"maxArrowLength", "*", 
                    RowBox[{"#2", "/", "fastestArrow"}]}]}], ",", "height"}], 
                  "}"}]}], "}"}], "]"}]}], "}"}]}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"arrowStarts", ",", "arrowChanges"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Exact", " ", "computations", " ", "of", " ", "rest", " ", "points"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"rest", "=", 
       RowBox[{"Reduce", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"ExpectedChange", "[", 
             RowBox[{"x1", ",", "m", ",", "L", ",", "FMatrix"}], "]"}], "==", 
            "0"}], ",", 
           RowBox[{"0", "<=", "x1", "<=", "1"}]}], "}"}], ",", "x1", ",", 
         "Reals"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Reduce", " ", "answers", " ", "with", " ", "a", " ", "disjunction", " ",
          "whose", " ", "branches", " ", "are", " ", "of", " ", "two", " ", 
         RowBox[{"kinds", ":", " ", 
          RowBox[{"an", " ", "equation"}]}]}], ",", " ", 
        RowBox[{
        "which", " ", "is", " ", "an", " ", "isolated", " ", "rest", " ", 
         "point"}], ",", " ", 
        RowBox[{"and", " ", "an", " ", "inequality"}], ",", " ", 
        RowBox[{
        "which", " ", "is", " ", "a", " ", "whole", " ", "component", " ", 
         "of", " ", "rest", " ", 
         RowBox[{"points", ".", " ", "Both"}], " ", "kinds", " ", "occur", " ",
          "together", " ", "whenever", " ", "the", " ", "average", " ", 
         "payoff", " ", "is", " ", "nonpositive", " ", "on", " ", "part", " ",
          "of", " ", "the", " ", "interval"}], ",", " ", 
        RowBox[{
        "so", " ", "they", " ", "are", " ", "separated", " ", "here", " ", 
         "instead", " ", "of", " ", "discarding", " ", 
         RowBox[{"either", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"restBranches", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rest", "===", "False"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "rest", "]"}], "===", "Or"}], ",", 
           RowBox[{"List", "@@", "rest"}], ",", 
           RowBox[{"{", "rest", "}"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"restRegions", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"restBranches", ",", 
         RowBox[{
          RowBox[{"Not", "[", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"#", ",", 
             RowBox[{
             "Less", "|", "LessEqual", "|", "Greater", "|", 
              "GreaterEqual"}]}], "]"}], "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"restPoints", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x1", "/.", 
              RowBox[{"ToRules", "[", "#", "]"}]}], ")"}], "&"}], ",", 
           RowBox[{"Select", "[", 
            RowBox[{"restBranches", ",", 
             RowBox[{
              RowBox[{"FreeQ", "[", 
               RowBox[{"#", ",", 
                RowBox[{
                "Less", "|", "LessEqual", "|", "Greater", "|", 
                 "GreaterEqual"}]}], "]"}], "&"}]}], "]"}]}], "]"}], ",", 
         "Less"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"restPointsX", "=", 
       RowBox[{"N", "[", "restPoints", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"The", " ", "endpoints", " ", "of", " ", "each", " ", 
         RowBox[{"component", ".", " ", "They"}], " ", "place", " ", "the", " ",
          "red", " ", "segments", " ", "on", " ", "the", " ", "phase", " ", 
         "line"}], ",", " ", 
        RowBox[{
        "and", " ", "they", " ", "bound", " ", "the", " ", "gaps", " ", "on", 
         " ", "which", " ", "RestPointTypes", " ", "reads", " ", "the", " ", 
         "sign", " ", "of", " ", "the", " ", "expected", " ", "change"}], ",",
         " ", 
        RowBox[{
        "so", " ", "that", " ", "no", " ", "gap", " ", "straddles", " ", "a", 
         " ", 
         RowBox[{"component", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"restBounds", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Quiet", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"MinValue", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x1", ",", "#"}], "}"}], ",", "x1"}], "]"}], ",", 
             RowBox[{"MaxValue", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x1", ",", "#"}], "}"}], ",", "x1"}], "]"}]}], "}"}], 
           "]"}], "&"}], ",", "restRegions"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"everyStateRests", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"restPoints", "===", 
          RowBox[{"{", "}"}]}], "&&", 
         RowBox[{"restBounds", "===", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], "}"}]}]}], ")"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"restPointTypes", "=", 
       RowBox[{"RestPointTypes", "[", 
        RowBox[{"restPoints", ",", 
         RowBox[{"Flatten", "[", "restBounds", "]"}], ",", "m", ",", "L", ",",
          "FMatrix"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"restEigen", "=", 
       RowBox[{"RestPointEigenvalues", "[", 
        RowBox[{"restPoints", ",", "m", ",", "L", ",", "FMatrix"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"restPools", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"PoolFromPopGivenL", "[", 
           RowBox[{"#", ",", "L"}], "]"}], "&"}], ",", "restPoints"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"We", "'"}], "re", " ", "ready", " ", "to", " ", "create", " ",
         "the", " ", 
        RowBox[{"figure", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"fontSize", "=", "16"}], ";", "\[IndentingNewLine]", 
      RowBox[{"figure", "=", 
       RowBox[{"Pane", "[", 
        RowBox[{"Column", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"PHASE", " ", "PORTRAIT"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Show", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Plot", "[", 
               RowBox[{
                RowBox[{"Evaluate", "@", 
                 RowBox[{"Fx", "[", 
                  RowBox[{"x1", ",", "L", ",", "FMatrix"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"x1", ",", "0", ",", "1"}], "}"}], ",", 
                RowBox[{"PlotRange", "->", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"0", ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"payoffMin", "-", 
                    RowBox[{"0.125", "*", "payoffSpan"}]}], ",", 
                    "payoffMax"}], "}"}]}], "}"}]}], ",", 
                RowBox[{"FrameLabel", "->", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"\"\<% \>\"", ",", "s1Name"}], "]"}], ",", 
                    "Black", ",", 
                    RowBox[{"fontSize", "+", "2"}]}], "]"}], 
                   ",", "\"\<Expected payoff\>\""}], "}"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"PlotStyle", "->", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Directive", "[", 
                    RowBox[{"Black", ",", 
                    RowBox[{"AbsoluteDashing", "[", 
                    RowBox[{"{", 
                    RowBox[{"12", ",", "0"}], "}"}], "]"}]}], "]"}], ",", 
                   RowBox[{"Directive", "[", 
                    RowBox[{"Black", ",", "Dashed"}], "]"}]}], "}"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
                RowBox[{"BaseStyle", "->", 
                 RowBox[{"{", "fontSize", "}"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{"PlotLegends", "->", 
                 RowBox[{"Placed", "[", 
                  RowBox[{
