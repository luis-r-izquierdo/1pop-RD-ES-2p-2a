            Inverse[IdentityMatrix[4] - Part[$CellContext`P, 
              Span[2, All], 
              Span[2, All]]], 
            Table[1, {4}]]]]; $CellContext`Ls[
          Pattern[$CellContext`s1, 
           Blank[List]], 
          Pattern[$CellContext`s2, 
           Blank[List]], 
          Pattern[$CellContext`\[Epsilon], 
           Blank[]], 
          Pattern[$CellContext`\[Delta], 
           Blank[]]] := {
          $CellContext`ExpectedTimeUntilBreakUp[$CellContext`s1, \
$CellContext`s1, $CellContext`\[Epsilon], $CellContext`\[Delta]], 
          $CellContext`ExpectedTimeUntilBreakUp[$CellContext`s1, \
$CellContext`s2, $CellContext`\[Epsilon], $CellContext`\[Delta]], 
          $CellContext`ExpectedTimeUntilBreakUp[$CellContext`s2, \
$CellContext`s2, $CellContext`\[Epsilon], $CellContext`\[Delta]]}; \
$CellContext`PoolFromPopGivenL[
          Pattern[$CellContext`x1, 
           Blank[]], 
          Pattern[$CellContext`L, 
           Blank[List]]] := 
        Module[{$CellContext`L11, $CellContext`Lx, $CellContext`L22}, \
{$CellContext`L11, $CellContext`Lx, $CellContext`L22} = $CellContext`L; 
          If[Max[{$CellContext`L11, $CellContext`Lx, $CellContext`L22}] - 
             Min[{$CellContext`L11, $CellContext`Lx, $CellContext`L22}] < 
            10^(-6), $CellContext`x1, 
            
            If[-$CellContext`L11 + $CellContext`Lx + ($CellContext`L11 + \
$CellContext`L22 - 2 $CellContext`Lx) $CellContext`x1 == 0, 
             
             If[$CellContext`Lx + 
               2 ($CellContext`L22 - $CellContext`Lx) $CellContext`x1 == 
              0, $CellContext`x1, ($CellContext`x1 \
$CellContext`L22)/($CellContext`Lx + 
              2 ($CellContext`L22 - $CellContext`Lx) $CellContext`x1)], \
($CellContext`Lx + 2 $CellContext`L22 $CellContext`x1 - 
              2 $CellContext`Lx $CellContext`x1 - 
              Sqrt[$CellContext`Lx^2 (1 - 2 $CellContext`x1)^2 - 
               4 $CellContext`L11 $CellContext`L22 (-1 + $CellContext`x1) \
$CellContext`x1])/(
             2 (-$CellContext`L11 + $CellContext`Lx + ($CellContext`L11 + \
$CellContext`L22 - 2 $CellContext`Lx) $CellContext`x1))]]]; $CellContext`Fx[
          Pattern[$CellContext`x1, 
           Blank[]], 
          Pattern[$CellContext`L, 
           Blank[List]], 
          Pattern[$CellContext`FMatrix, 
           Blank[]]] := 
        Module[{$CellContext`L11, $CellContext`Lx, $CellContext`L22, \
$CellContext`p1}, {$CellContext`L11, $CellContext`Lx, $CellContext`L22} = \
$CellContext`L; $CellContext`p1 = \
$CellContext`PoolFromPopGivenL[$CellContext`x1, $CellContext`L]; 
          Dot[Transpose[{$CellContext`p1, 1 - $CellContext`p1} 
               Transpose[{{$CellContext`L11, $CellContext`Lx}, \
{$CellContext`Lx, $CellContext`L22}}]] $CellContext`FMatrix, {1, 1}]/Dot[
            
            Transpose[{$CellContext`p1, 1 - $CellContext`p1} 
             Transpose[{{$CellContext`L11, $CellContext`Lx}, \
{$CellContext`Lx, $CellContext`L22}}]], {1, 1}]]; $CellContext`Replicator[
          Pattern[$CellContext`x, 
           Blank[]], 
          Pattern[$CellContext`\[CapitalPi], 
           Blank[]]] := 
        Module[{$CellContext`avgPayoff = 
           Dot[$CellContext`x, $CellContext`\[CapitalPi]]}, $CellContext`x \
$CellContext`\[CapitalPi] - $CellContext`avgPayoff $CellContext`x]; \
$CellContext`ExpectedChange[
          Pattern[$CellContext`x1, 
           Blank[]], 
          Pattern[$CellContext`m, 
           Blank[]], 
          Pattern[$CellContext`L, 
           Blank[List]], 
          Pattern[$CellContext`FMatrix, 
           Blank[]]] := 
        Module[{$CellContext`\[CapitalPi]}, $CellContext`\[CapitalPi] = \
$CellContext`Fx[$CellContext`x1, $CellContext`L, $CellContext`FMatrix]; (
             1 - $CellContext`m) $CellContext`Replicator[{$CellContext`x1, 
               1 - $CellContext`x1}, $CellContext`\[CapitalPi]] + \
$CellContext`m (
             ConstantArray[1/2, 2] - {$CellContext`x1, 
              1 - $CellContext`x1})]; $CellContext`ChangeInX1[
          Pattern[$CellContext`x1, 
           Blank[]], 
          Pattern[$CellContext`m, 
           Blank[]], 
          Pattern[$CellContext`L, 
           Blank[List]], 
          Pattern[$CellContext`FMatrix, 
           Blank[]]] := Together[
          First[
           $CellContext`ExpectedChange[$CellContext`x1, $CellContext`m, \
$CellContext`L, $CellContext`FMatrix]]]; $CellContext`RationalBetween[
          Pattern[$CellContext`a, 
           Blank[]], 
          Pattern[$CellContext`b, 
           Blank[]]] := 
        Module[{$CellContext`digits = 40, $CellContext`q = Null}, 
          While[$CellContext`digits < 2000, $CellContext`q = Rationalize[
               N[($CellContext`a + $CellContext`b)/2, $CellContext`digits], 
               0]; If[
              TrueQ[
               Reduce[$CellContext`a < $CellContext`q < $CellContext`b]], 
              Return[$CellContext`q]]; $CellContext`digits = 
             2 $CellContext`digits]; ($CellContext`a + $CellContext`b)/
           2]; $CellContext`RestPointTypes[
          Pattern[$CellContext`restPoints, 
           Blank[List]], 
          Pattern[$CellContext`extraBounds, 
           Blank[List]], 
          Pattern[$CellContext`m, 
           Blank[]], 
          Pattern[$CellContext`L, 
           Blank[List]], 
          Pattern[$CellContext`FMatrix, 
           Blank[]]] := 
        Module[{$CellContext`bounds, $CellContext`separators, \
$CellContext`signs, $CellContext`k, $CellContext`below, $CellContext`above}, 
          If[$CellContext`restPoints === {}, 
            Return[{}]]; $CellContext`bounds = DeleteDuplicates[
             Sort[
              Join[{0, 1}, $CellContext`restPoints, $CellContext`extraBounds],
               Less]]; $CellContext`separators = Table[
             $CellContext`RationalBetween[
              Part[$CellContext`bounds, $CellContext`i], 
              Part[$CellContext`bounds, $CellContext`i + 1]], {$CellContext`i,
               Length[$CellContext`bounds] - 1}]; $CellContext`signs = 
           Map[Sign[
              $CellContext`ChangeInX1[#, $CellContext`m, $CellContext`L, \
$CellContext`FMatrix]]& , $CellContext`separators]; 
          Table[$CellContext`k = First[
               
               FirstPosition[$CellContext`bounds, $CellContext`r]]; \
$CellContext`below = If[$CellContext`k > 1, 
               Part[$CellContext`signs, $CellContext`k - 1], 
               Null]; $CellContext`above = 
             If[$CellContext`k <= Length[$CellContext`separators], 
               Part[$CellContext`signs, $CellContext`k], Null]; 
            Which[$CellContext`below === Null, 
              
              Which[$CellContext`above === -1, "sink", $CellContext`above === 
               1, "source", True, "undetermined"], $CellContext`above === 
              Null, 
              
              Which[$CellContext`below === 1, 
               "sink", $CellContext`below === -1, "source", True, 
               "undetermined"], 
              And[$CellContext`below === 1, $CellContext`above === -1], 
              "sink", 
              And[$CellContext`below === -1, $CellContext`above === 1], 
              "source", True, 
              "undetermined"], {$CellContext`r, $CellContext`restPoints}]]; \
$CellContext`RestPointColor[
          Pattern[$CellContext`type, 
           Blank[]]] := Switch[$CellContext`type, "sink", 
          Darker[Green], "source", Red, 
          Blank[], Gray]; $CellContext`RestPointDerivative[
          Pattern[$CellContext`L, 
           Blank[List]], 
          Pattern[$CellContext`FMatrix, 
           Blank[]], 
          Pattern[$CellContext`m, 
           Blank[]], 
          Pattern[$CellContext`x, 
           Blank[]], 
          Pattern[$CellContext`p, 
           Blank[]]] := 
        Module[{$CellContext`y, $CellContext`q, $CellContext`L11, \
$CellContext`Lx, $CellContext`L22, $CellContext`aRow, $CellContext`bRow, \
$CellContext`G, $CellContext`P1, $CellContext`P2, $CellContext`avg, \
$CellContext`V, $CellContext`gq, $CellContext`val}, {$CellContext`L11, \
$CellContext`Lx, $CellContext`L22} = $CellContext`L; $CellContext`aRow = \
$CellContext`L11 $CellContext`q + $CellContext`Lx (
              1 - $CellContext`q); $CellContext`bRow = $CellContext`Lx \
$CellContext`q + $CellContext`L22 (
              1 - $CellContext`q); $CellContext`G = $CellContext`y \
($CellContext`q $CellContext`aRow + (
                1 - $CellContext`q) $CellContext`bRow) - $CellContext`q \
$CellContext`aRow; $CellContext`P1 = (
             Part[$CellContext`FMatrix, 1, 1] $CellContext`L11 $CellContext`q + 
             Part[$CellContext`FMatrix, 1, 2] $CellContext`Lx (
               1 - $CellContext`q))/$CellContext`aRow; $CellContext`P2 = (
             Part[$CellContext`FMatrix, 2, 1] $CellContext`Lx $CellContext`q + 
             Part[$CellContext`FMatrix, 2, 2] $CellContext`L22 (
               1 - $CellContext`q))/$CellContext`bRow; $CellContext`avg = \
$CellContext`y $CellContext`P1 + (
              1 - $CellContext`y) $CellContext`P2; $CellContext`V = (
              1 - $CellContext`m) $CellContext`y ($CellContext`P1 - \
$CellContext`avg) + $CellContext`m (1/2 - $CellContext`y); $CellContext`gq = 
           Together[
             ReplaceAll[
              
              D[$CellContext`G, $CellContext`q], {$CellContext`y -> \
$CellContext`x, $CellContext`q -> $CellContext`p}]]; If[
            Or[
             Not[
              NumericQ[$CellContext`gq]], 
             TrueQ[$CellContext`gq == 0]], 
            Return[Indeterminate]]; $CellContext`val = Together[
             ReplaceAll[
             D[$CellContext`V, $CellContext`y] - 
              D[$CellContext`V, $CellContext`q] (
               D[$CellContext`G, $CellContext`y]/
               D[$CellContext`G, $CellContext`q]), {$CellContext`y -> \
$CellContext`x, $CellContext`q -> $CellContext`p}]]; If[
            NumericQ[$CellContext`val], $CellContext`val, 
            Indeterminate]]; $CellContext`RestPointEigenvalues[
          Pattern[$CellContext`restPoints, 
           Blank[List]], 
          Pattern[$CellContext`m, 
           Blank[]], 
          Pattern[$CellContext`L, 
           Blank[List]], 
          Pattern[$CellContext`FMatrix, 
           Blank[]]] := 
        Map[$CellContext`RestPointDerivative[$CellContext`L, \
$CellContext`FMatrix, $CellContext`m, #, 
           $CellContext`PoolFromPopGivenL[#, $CellContext`L]]& , \
$CellContext`restPoints]; $CellContext`RestPointDot[
          Pattern[$CellContext`type, 
           Blank[]]] := Graphics[{
           EdgeForm[
            Directive[Thin, Black]], 
           $CellContext`RestPointColor[$CellContext`type], 
           Disk[]}, ImageSize -> 9]; $CellContext`RestPointTag[
          Pattern[$CellContext`type, 
           Blank[]]] := Row[{
           $CellContext`RestPointDot[$CellContext`type], "\[ThinSpace]", 
           Style[$CellContext`type, 10]}]; $CellContext`RestPointLegend[
          Pattern[$CellContext`types, 
           Blank[]]] := Row[
          Riffle[
           Map[$CellContext`RestPointTag, 
            
            Select[{"sink", "source", "undetermined"}, 
             MemberQ[$CellContext`types, #]& ]], 
           "\[ThickSpace]\[ThickSpace]"]]; $CellContext`StrategyName[
          Pattern[$CellContext`s, 
           Blank[List]]] := 
        Switch[$CellContext`s, {0, 0, 2, 0, 2}, "CSL", {1, 1, 2, 1, 2}, 
          "DSL", {0, 0, 2, 2, 0}, "c0a", {0, 0, 2, 2, 2}, "c0b", {1, 0, 2, 2, 
          0}, "Leaver", {1, 1, 1, 1, 1}, "Defector", {0, 0, 0, 0, 0}, 
          "Cooperator", {1, 2, 2, 2, 2}, "Defect&Leave", {0, 0, 1, 1, 0}, 
          "WSLS", {1, 0, 1, 1, 0}, "nWSLS", {0, 0, 1, 1, 1}, "Grim", {0, 0, 1,
           0, 1}, "TFT", {0, 0, 1, 0, 0}, "TFTlike", {1, 0, 2, 1, 0}, 
          "leaver1", {1, 0, 2, 0, 0}, "leaver3", 
          Blank[], 
          $CellContext`ToLetters[$CellContext`s]]; $CellContext`ToLetters[
          Pattern[$CellContext`s, 
           Blank[List]]] := StringJoin[
          ReplaceAll[$CellContext`s, {0 -> "C", 1 -> "D", 2 -> "L"}]]; Null}; 
     Typeset`initDone$$ = True),
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"456ee322-c953-43ea-93b4-e66fbd605412"],

Cell[CellGroupData[{

Cell["Documentation", "Section",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"e5b48c76-9ef9-435c-93ae-347850a12596"],

Cell["\<\
This notebook shows the expected payoff of each of two strategies and the \
phase portrait of the one-population replicator dynamics in any repeated \
2-player 2-action game with endogenous separation.\
\>", "Text",ExpressionUUID->"8c845bcb-a751-4dec-8482-ce147cb1ad0b"],

Cell[CellGroupData[{

Cell["Parameters", "Subsection",ExpressionUUID->"590dddd8-31a9-4c5f-b4c8-2bf175fb5cbb"],

Cell[CellGroupData[{

Cell["Payoffs", "Subsubsection",ExpressionUUID->"c076fe37-74af-4c6c-9752-2049e3ce6a44"],

Cell[TextData[{
 "The stage game is defined by the payoff matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["a", "ij"], "]"}], TraditionalForm]],ExpressionUUID->
  "3f53b331-8935-4953-8ba5-eaf0181f118d"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "ij"], TraditionalForm]],ExpressionUUID->
  "b39d4a77-9bb4-40af-9831-983ee13d39e3"],
 " represents the payoff obtained by a player who plays action i against a \
player who plays action j, with i and j each C or D. After changing the \
payoffs, the user should click on the button \[OpenCurlyDoubleQuote]Update\
\[CloseCurlyDoubleQuote] to run the computations with the new payoffs. The \
program also contains a set of predefined games which can be chosen from the \
menu above the matrix."
}], "Text",ExpressionUUID->"7d6bdaef-365b-4320-ac7c-966c6db12e1c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Strategies", "Subsubsection",ExpressionUUID->"2eaed39b-5511-4ec6-91fc-673e4fd1cbe8"],

Cell["Strategies are determined by the following five \
\[OpenCurlyDoubleQuote]genes\[CloseCurlyDoubleQuote]:", "Text",ExpressionUUID->\
"43be6ad7-59cb-434b-aebd-390f8849047f"],

Cell[TextData[StyleBox["Initial: The first gene determines the individual\
\[CloseCurlyQuote]s first action, i.e. the action (C or D) when the \
individual interacts with her partner for the very first time.", "Item"]], \
"Item",ExpressionUUID->"81895113-ea99-4768-8374-34d1c25411bc"],

Cell[TextData[StyleBox["After CC: The second gene determines what to do when \
the outcome of the interaction has been CC, i.e. both players have played C. \
The options are:", "Item"]], "Item",ExpressionUUID->"6816733d-a258-49e1-93e7-\
234ff6e5e299"],

Cell[TextData[StyleBox["C: Stay with the current partner and, assuming the \
partnership continues, play C in the following time-step.", "Item"]], \
"Subitem",ExpressionUUID->"52dc2971-0320-4945-ad8e-b742af5bf4ca"],

Cell[TextData[StyleBox["D: Stay with the current partner and, assuming the \
partnership continues, play D in the following time-step.", "Item"]], \
"Subitem",ExpressionUUID->"98ed99d6-b4eb-4137-970f-51c7a4573dfe"],

Cell[TextData[StyleBox["L: Leave the current partnership. In this case, the \
partnership is broken regardless of the decision of the partner.", "Item"]], \
"Subitem",ExpressionUUID->"8dcab4ef-85dc-4142-9d80-a1cf4986801b"],

Cell[TextData[StyleBox["After CD: The third gene determines the choice -also \
C, D or L- after outcome CD, which denotes the situation where the individual \
has played C and the partner has played D.", "Item"]], "Item",ExpressionUUID->\
"8f300e86-53bd-4204-870e-3fc7abb719d3"],

Cell[TextData[StyleBox["After DC: The fourth gene determines the choice (C, D \
or L) after outcome DC, which denotes the situation where the individual has \
played D and the partner has played C.", "Item"]], "Item",ExpressionUUID->\
"ca3b8f61-65f3-4408-aaa0-0b2432880027"],

Cell[TextData[StyleBox["After DD: Finally, the fifth gene determines the \
choice (C, D or L) after outcome DD, i.e. when the two players have defected. \
", "Item"]], "Item",ExpressionUUID->"9ed479f3-6a45-4384-a848-ba0ebda4f1af"],

Cell["\<\
A strategy thus specifies a course of action at every possible juncture in an \
individual\[CloseCurlyQuote]s life. We permit the 2\[CenterDot]3\[CenterDot]3\
\[CenterDot]3\[CenterDot]3 = 162 possible strategies. Hence, there are (162\
\[CenterDot]161)/2 = 13041 possible pairs of distinct strategies, and the program may also be \
given the same strategy twice. Strategies that have a name are shown by \
that name; the rest are shown by their five genes, written as a string of \
Cs, Ds and Ls. The chooser at the right of each row offers a selection of \
named strategies.\
\>", "Text",ExpressionUUID->"6d9bfa5c-7bc9-47bc-ae71-759b6ce57154"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Probability of action error \[Epsilon]", "Subsubsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"5985c2db-a143-429f-80ca-2bfedd227236"],

Cell["Errors work as follows: whenever an agent is going to play the game, with probability \[Epsilon], she makes an error (so if she intended to cooperate, she defects, and vice versa), and with probability (1-\[Epsilon]) she follows her prescribed action. The error affects only the choice between C and D: a decision to leave the partnership is never made by mistake.", "Text",ExpressionUUID->"cd4d2de9-ce08-40b7-86bc-0f829db4301b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Probability of continuation \[Delta]", "Subsubsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"c31057d9-c246-4446-9322-91110e3310ce"],

Cell[TextData[{
 "\[Delta] is the probability of continuation for the partnership. Thus, \
\[Gamma] = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", "\[Delta]"}], ")"}], 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "92a3241a-ba85-4cb2-93f2-6ce2ef565422"],
 " is the expected number of interactions of partnerships whose members do \
not choose to break up. A partnership can also end endogenously, when at \
least one of the partners plays L, and different pairs of strategies stay \
together for different expected times. Individuals whose partnership has \
ended return to a pool of singles, from which new partnerships are formed \
at random. These expected durations are what makes the composition of that \
pool differ from the composition of the population; the tables of rest \
points below give both, the population shares as x and the pool shares as \
p."
}], "Text",ExpressionUUID->"4b87dbdd-2993-4142-a774-6fd50bd07639"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Probability of experimentation \[Mu]", "Subsubsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"bfaf77e0-e6d2-4970-b577-864e9e9975b4"],

Cell[TextData[{
 "The basic dynamic ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     SubscriptBox["x", "i"], "."], "=", 
    RowBox[{
     SubscriptBox["f", "i"], "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "2"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "a12ed43a-8112-413f-a380-42ea86878076"],
 " can be modified by allowing revising players to choose their new strategy \
at random (among the 2 allowed) with a certain probability \[Mu]. Formally, \
the altered dynamic which includes this feature reads as follows: "
}], "Text",ExpressionUUID->"7a73b3c6-6ad5-40f9-b61d-cc385c114f05"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{" ", 
      RowBox[{
       OverscriptBox[
        SubscriptBox["x", "i"], "."], "=", 
       RowBox[{GridBox[{
          {
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "\[Mu]"}], ")"}], " ", 
            RowBox[{
             SubscriptBox["f", "i"], "(", 
             RowBox[{
              SubscriptBox["x", "1"], ",", 
              SubscriptBox["x", "2"]}], ")"}]}]}
         },
         GridBoxAlignment->{"Columns" -> {{"="}}}], "+", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", "2"], "-", 
           SubscriptBox["x", "i"]}], ")"}]}]}]}]}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"2714c35c-4ed8-4281-8207-ab8caa5ce4d0"]], \
"Text",ExpressionUUID->"dc6836c9-62ff-4dcf-ba8e-ccd844a6dd73"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Arrows", "Subsubsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"bed87209-639e-4e3a-80bb-89dca27c294f"],

Cell[TextData[{
 "Parameter ",
 Cell[BoxData[
  FormBox[
   StyleBox["length",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "817f5da3-006a-49c1-bd48-717866da2795"],
 " controls the length of the arrows, which show the expected change in the \
dynamics. Arrows are computed for a grid of states of mesh 1/N, where N is controlled with the setter labeled \[OpenCurlyDoubleQuote]show\[CloseCurlyDoubleQuote], whose possible values are: \[OpenCurlyDoubleQuote]all\[CloseCurlyDoubleQuote] (N=32), \[OpenCurlyDoubleQuote]many\[CloseCurlyDoubleQuote] (N=16), \[OpenCurlyDoubleQuote]some\[CloseCurlyDoubleQuote] (N=8), \
\[OpenCurlyDoubleQuote]few\[CloseCurlyDoubleQuote] (N=4), and \
\[OpenCurlyDoubleQuote]none\[CloseCurlyDoubleQuote] (no arrows). The arrows are scaled so that the fastest one on the grid is drawn at the maximum length, so their lengths show the speeds relative to one another rather than on an absolute scale."
}], "Text",ExpressionUUID->"26f7cd6e-d2ee-40d9-bc15-744401e7e367"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Output", "Subsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"597b3f87-ed10-4d79-b4a4-749e420985f7"],

Cell["The program shows a figure in which the expected payoff of each of the two strategies is plotted against the share of the first one, which runs along the horizontal axis from 0% to 100%. The solid line is the first strategy and the dashed line is the second, and both are named in the legend. The phase line runs below the two curves, inside the same frame: the arrows on it show the expected change of the state, and the discs on it are the rest points.\n\nIsolated rest points are drawn as discs, colored by their type: green for a sink, red for a source, and gray when the type is undetermined. The type is read off the sign of the expected change on the two intervals that meet at the rest point: inward on both sides is a sink, outward on both is a source, and equal signs leave the type undetermined. Nothing here depends on a step size or on a threshold. A legend under the figure lists the types that occur.\n\nUnder the figure, the isolated rest points are also shown as a table: the share of each of the two strategies in the population, and their shares in the pool of single individuals. Both components are listed in each case, even though they add up to one, so that each distribution can be read off directly. The table also gives \[Lambda], the derivative of the expected change at the point, which in one dimension is the only eigenvalue of the Jacobian. It is exact, obtained by implicit differentiation of the condition that relates the pool of single individuals with the population, and it is a second and independent reading of the type: it is negative at a sink and positive at a source. A vanishing \[Lambda] leaves the linearization undecided, and the type is then settled by the signs of the flow alone.\n\nWhen the rest points are not isolated but form a whole component, the component is drawn as a thick red segment on the phase line and described in a second table. Components are not classified, since along one the derivative of the expected change is zero. When every state is a rest point, which happens when the two strategies earn the same payoff against every mixture, the figure says so.\n\nThe displayed figure can be exported in vector pdf format by clicking on the button \[OpenCurlyDoubleQuote]Export figure\[CloseCurlyDoubleQuote]. The production of this file (the .pdf figure) is not permitted in the free Wolfram Player. It requires Mathematica. The button \[OpenCurlyDoubleQuote]Generate full report\[CloseCurlyDoubleQuote] opens a new notebook with the parameters, the figure, the exact isolated rest points with the composition of the pool of single individuals at each of them, their \[Lambda] and their type, the exact components, and the solution set as Reduce returned it.", "Text",ExpressionUUID->"6b7ccf26-cf8a-48fc-aa7a-33705c52788c"]
}, Open  ]]
}, Closed]],

